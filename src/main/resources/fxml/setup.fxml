<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ftt.controllers.SetupController">
   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="10.0" vgrow="NEVER" />
      <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" vgrow="NEVER" />
   </rowConstraints>
   <children>
      <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="40.0" prefWidth="600.0" GridPane.hgrow="NEVER" GridPane.vgrow="NEVER">
         <children>
            <Label text="Запись">
               <HBox.margin>
                  <Insets left="15.0" right="10.0" />
               </HBox.margin>
            </Label>
            <ComboBox fx:id="writeType" prefHeight="22.0" prefWidth="272.0" />
         </children>
      </HBox>
      <TableView id="tableView" fx:id="tableView" prefHeight="200.0" prefWidth="200.0" GridPane.rowIndex="1">
        <columns>
          <TableColumn fx:id="osColumn" maxWidth="27.0" prefWidth="27.0" sortable="false" text="Ось" />
          <TableColumn fx:id="pColumn" maxWidth="30.0" prefWidth="30.0" sortable="false" text="✎" />
            <TableColumn fx:id="lColumn" maxWidth="500.0" prefWidth="81.0" sortable="false" text="Порог" />
            <TableColumn fx:id="lineColumn" maxWidth="500.0" minWidth="0.0" prefWidth="380.0" sortable="false" text="Линия" />
        </columns>
         <padding>
            <Insets top="1.0" />
         </padding>
         <GridPane.margin>
            <Insets />
         </GridPane.margin>
      </TableView>
      <VBox GridPane.rowIndex="2">
         <children>
            <TextField fx:id="filename" prefHeight="22.0" prefWidth="349.0" promptText="Добавочное значение к имени файла...">
               <VBox.margin>
                  <Insets left="15.0" right="15.0" top="5.0" />
               </VBox.margin>
            </TextField>
            <TextArea fx:id="description" prefHeight="52.0" prefWidth="600.0" promptText="Коментарий...">
               <VBox.margin>
                  <Insets bottom="5.0" left="15.0" right="15.0" top="5.0" />
               </VBox.margin>
            </TextArea>
         </children>
      </VBox>
   </children>
</GridPane>
