<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<GridPane prefHeight="480.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ftt.controllers.RecController">
  <columnConstraints>
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints maxHeight="1.7976931348623157E308" minHeight="10.0" prefHeight="290.0" vgrow="ALWAYS" />
    <RowConstraints maxHeight="195.0" minHeight="6.0" prefHeight="45.0" />
      <RowConstraints maxHeight="195.0" minHeight="10.0" prefHeight="168.0" />
  </rowConstraints>
   <children>
      <GridPane maxWidth="800.0" minWidth="800.0" prefWidth="800.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="400.0" minWidth="400.0" prefWidth="400.0" />
            <ColumnConstraints maxWidth="400.0" minWidth="400.0" prefWidth="400.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <HBox alignment="CENTER_RIGHT" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="36.0" prefWidth="294.0" GridPane.columnIndex="1">
               <children>
                  <ToggleButton fx:id="play" mnemonicParsing="false" onAction="#play" text="►">
                     <font>
                        <Font name="Times New Roman" size="12.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </ToggleButton>
                  <ToggleButton fx:id="pause" mnemonicParsing="false" onAction="#pause" text="||">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </ToggleButton>
                  <Button mnemonicParsing="false" onAction="#stop" text="■">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="0">
               <children>
                  <Label fx:id="info" text="Info">
                     <padding>
                        <Insets left="15.0" />
                     </padding>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children></HBox>
         </children>
      </GridPane>
      <BorderPane fx:id="pane" prefHeight="200.0" prefWidth="200.0" />
      <BorderPane prefHeight="72.0" prefWidth="484.0" GridPane.rowIndex="2">
         <center>
            <TableView fx:id="tableView" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="visColumn" prefWidth="39.0" text="✔" />
                <TableColumn fx:id="namColumn" prefWidth="135.0" text="Канал" />
                  <TableColumn fx:id="valueColumn" prefWidth="75.0" text="Значение" />
              </columns>
               <BorderPane.margin>
                  <Insets top="5.0" />
               </BorderPane.margin>
            </TableView>
         </center>
         <right>
            <AnchorPane prefHeight="168.0" prefWidth="174.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="save" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#save" prefHeight="25.0" prefWidth="99.0" text="Сохранить" />
               </children></AnchorPane>
         </right>
      </BorderPane>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" />
      <BorderPane fx:id="pane" layoutX="10.0" layoutY="10.0" />
   </children>
</GridPane>
